# GioCasa Gaming Booking System Environment Variables

# Server Port
PORT=5001

# MongoDB Atlas Free Tier (M0) Connection String
# Paste your MongoDB Atlas URI below. If left empty, the server automatically uses the local persistent JSON database.
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# MongoDB Database Name
MONGODB_DB_NAME=giocasa

# Admin Passcode for Staff Operations Dashboard
ADMIN_PASSCODE=GIOCASA2026

# Timezone (India Standard Time)
TZ=Asia/Kolkata

# Optional: Production Frontend Backend API Base URL (defaults to /api on localhost)
# VITE_API_BASE_URL=https://giogit.onrender.com
